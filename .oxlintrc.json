{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "import"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "typescript/no-non-null-assertion": "off"
  },
  "ignorePatterns": [".agents/skills/**", "DESIGN.md", "**/dist/**", "docs/site/**", "docs/.cache/**"]
}
