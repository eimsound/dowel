{
  "name": "dowel",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p apps/web && tsc --noEmit -p apps/web/tsconfig.test.json",
    "lint": "oxlint --type-aware --deny-warnings && oxfmt --check",
    "format": "oxfmt",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "dev": "node --run dev:server & pnpm --filter @dowel/web dev",
    "dev:server": "node --conditions=@dowel/source --watch apps/server/src/main.ts",
    "build": "tsdown && pnpm --filter @dowel/web build",
    "start": "node apps/server/dist/main.js",
    "e2e": "playwright test",
    "docs:dev": "uvx zensical==0.1.3 serve",
    "docs:build": "uvx zensical==0.1.3 build --clean --strict"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@dowel/engines": "workspace:*",
    "@dowel/executor": "workspace:*",
    "@playwright/test": "^1.65.1",
    "@testcontainers/mssqlserver": "12.2.1",
    "@testcontainers/mysql": "12.2.1",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/mssql": "^12.3.0",
    "@types/node": "^26.6.6",
    "fast-check": "^4.10.2",
    "mssql": "12.7.14",
    "mysql2": "^3.24.6",
    "oauth2-mock-server": "^9.3.0",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2007",
    "postgres": "^4.1.1",
    "testcontainers": "^12.2.1",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.21.0"
}
